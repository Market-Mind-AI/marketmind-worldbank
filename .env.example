APP_NAME=marketmind-worldbank
APP_ENV=local
APP_PORT=8003

DATABASE_HOST=postgres
DATABASE_PORT=5432
# Host-exposed port for this service's Postgres — must be 5434 when running
# all 5 MarketMind services together (marketmind-core's own .env expects
# WorldBank on 5434). See marketmind-core/docs/marketmind-setup-ecossistema.md.
DATABASE_EXTERNAL_PORT=5434
DATABASE_NAME=marketmind_worldbank
DATABASE_USER=marketmind
DATABASE_PASSWORD=admin

# TLS da conexão Postgres: disable | require | verify-full.
# "disable" para o docker-compose local (sem listener TLS). O Azure Database
# for PostgreSQL Flexible Server recusa conexão em texto puro
# (require_secure_transport = ON), então lá precisa ser "require" no mínimo.
DATABASE_SSL_MODE=disable

WORLDBANK_BASE_URL=https://api.worldbank.org/v2
DEFAULT_FORMAT=json
DEFAULT_PER_PAGE=1000
DEFAULT_TIMEOUT=30
DEFAULT_RETRIES=3
DEFAULT_BACKOFF=2

LOG_LEVEL=INFO
